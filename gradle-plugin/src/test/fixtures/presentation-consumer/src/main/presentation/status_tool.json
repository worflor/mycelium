{
  "item": "fixture:status_tool",
  "base": "fixture:item/status_tool_base",
  "inputs": {
    "broken": {"component": "fixture:tool_state", "field": "broken", "domain": "bool"},
    "wear": {"component": "fixture:tool_state", "field": "wear", "domain": {"int": [0, 2]}},
    "charge": {"component": "fixture:tool_state", "field": "charge", "domain": {"int": [0, 3]}}
  },
  "cases": [
    {"when": {"broken": true}, "model": "fixture:item/status_tool_broken"},
    {"when": {"charge": {"min": 1}}, "model": "fixture:item/status_tool_charged_{charge}_worn_{wear}"},
    {"when": {"wear": {"min": 1}}, "model": "fixture:item/status_tool_worn_{wear}"}
  ]
}
